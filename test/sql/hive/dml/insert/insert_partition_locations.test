# name: test/sql/hive/dml/insert/insert_partition_locations.test
# description: partitions registered at locations other than their own directory: a new partition that would land in another partition's location is refused, two partitions at one location are refused on read, and s3a:// and '//' locations are read and written like Hadoop's Path reads them
# group: [insert]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# partition 'b' lives in the directory a new partition '5' would get
statement ok
DROP TABLE IF EXISTS my_datalake.default.ploc_collide;

statement ok
CREATE TABLE my_datalake.default.ploc_collide PARTITIONED BY (p) AS SELECT 'a' AS v, 'a' AS p;

statement ok
CALL glue_add_partition('my_datalake.default.ploc_collide', {p: 'b'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ploc_collide/p=5');

statement ok
INSERT INTO my_datalake.default.ploc_collide VALUES ('in b', 'b');

statement error
INSERT INTO my_datalake.default.ploc_collide VALUES ('new5', '5');
----
<REGEX>:.*a new partition would be written to 'p=5', the location of partition \[b\], and read back as that partition.*

query II
SELECT p, string_agg(v, ',' ORDER BY v) FROM my_datalake.default.ploc_collide GROUP BY p ORDER BY p;
----
a	a
b	in b

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.ploc_collide') WHERE p = '5';
----
0

statement ok
DROP TABLE my_datalake.default.ploc_collide;

# two partitions registered at one location: a file belongs to one of them here, Hive engines read it for both
statement ok
DROP TABLE IF EXISTS my_datalake.default.ploc_shared;

statement ok
CREATE TABLE my_datalake.default.ploc_shared PARTITIONED BY (p) AS SELECT 'z' AS v, 'z' AS p;

statement ok
CALL glue_add_partition('my_datalake.default.ploc_shared', {p: 'a'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ploc_shared/shared');

statement ok
CALL glue_add_partition('my_datalake.default.ploc_shared', {p: 'b'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ploc_shared/shared');

statement ok
INSERT INTO my_datalake.default.ploc_shared VALUES ('in a', 'a');

statement error
SELECT * FROM my_datalake.default.ploc_shared;
----
<REGEX>:.*Partitions \[a\] and \[b\] of Hive table .* are registered at the same location .*which DuckDB can not read.*

query I
SELECT v FROM my_datalake.default.ploc_shared WHERE p = 'z';
----
z

statement ok
DROP TABLE my_datalake.default.ploc_shared;

# s3a:// and a '//' in a partition location mean the same S3 prefix as s3:// and '/'
statement ok
DROP TABLE IF EXISTS my_datalake.default.ploc_spelled;

statement ok
CREATE TABLE my_datalake.default.ploc_spelled PARTITIONED BY (p) AS SELECT 'z' AS v, 'z' AS p;

statement ok
CALL glue_add_partition('my_datalake.default.ploc_spelled', {p: 'dbl'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ploc_spelled//p=dbl');

statement ok
CALL glue_add_partition('my_datalake.default.ploc_spelled', {p: 's3a'},
    location := replace('{DEFAULT_S3_LOCATION}', 's3://', 's3a://') || '/{TEST_DIR}/default/ploc_spelled/p=s3a');

statement ok
INSERT INTO my_datalake.default.ploc_spelled VALUES ('d1', 'dbl'), ('a1', 's3a'), ('z2', 'z');

query II
SELECT p, string_agg(v, ',' ORDER BY v) FROM my_datalake.default.ploc_spelled GROUP BY p ORDER BY p;
----
dbl	d1
s3a	a1
z	z,z2

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.ploc_spelled');
----
3

statement ok
DROP TABLE my_datalake.default.ploc_spelled;
